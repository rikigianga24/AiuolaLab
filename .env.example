# Copia questo file in .env e inserisci i tuoi valori. .env NON va committato.

PORT=3001

# --- Database piante (Perenual: https://perenual.com/docs/api) ---
# Senza chiave l'app usa un piccolo catalogo di esempio.
PERENUAL_API_KEY=
# PERENUAL_API_BASE=https://perenual.com/api/v2

# --- Postgres per i progetti (Supabase, Neon, Railway, locale...) ---
# Esempio Supabase: postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=
# Metti true per i database in cloud che richiedono SSL
DATABASE_SSL=false

# --- Consulente IA (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Richieste IA massime per IP all'ora
# SUGGEST_RATE_LIMIT=20
