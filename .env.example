# Copia questo file in .env e inserisci i tuoi valori. .env NON va committato.
# Tutte le voci sono facoltative: senza, la funzione corrispondente è spenta.

PORT=3001
# Indirizzo pubblico dell'app (usato nei link delle email). In locale:
APP_URL=http://localhost:5173

# --- Database (Postgres: Supabase, Neon, Railway, locale...) ---
# Serve per: account, progetti nel cloud, notifiche, cache piante.
# Su Supabase: Project Settings > Database > Connection string > URI (Session pooler).
DATABASE_URL=
# true per i database in cloud che richiedono SSL (Supabase, Neon: true)
DATABASE_SSL=false

# --- Piante ---
# Di default l'app usa il catalogo interno (server/plants/catalog).
# Per usare Perenual (https://perenual.com/docs/api, a pagamento per uso
# commerciale) imposta PLANT_PROVIDER=perenual e la chiave.
# PLANT_PROVIDER=perenual
PERENUAL_API_KEY=

# --- Consulente IA (Claude) ---
ANTHROPIC_API_KEY=
# SUGGEST_RATE_LIMIT=20

# --- Email ---
# Consigliato: API di Brevo (passa da HTTPS, funziona anche su Render gratuito,
# che blocca le porte SMTP). Chiave in Brevo: SMTP & API > API Keys.
BREVO_API_KEY=
# In alternativa SMTP (non funziona sul piano gratuito di Render):
# Su Brevo trovi server, porta, login e chiave nella sezione "SMTP & API".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Il mittente deve essere un indirizzo/dominio verificato sul provider.
MAIL_FROM="AiuolaLab <noreply@tuodominio.it>"

# --- Notifiche push sul telefono (Web Push) ---
# Genera le chiavi una volta con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tua@email.it

# --- Meteo (MET Norway) e foto delle piante (iNaturalist) ---
# Nessuna chiave. I loro termini chiedono un contatto: email o sito.
WEATHER_CONTACT=tua@email.it

# Ora delle notifiche giornaliere (fuso Europe/Rome), di default 8.
# NOTIFY_HOUR=8
# SCHEDULER=off  per disattivare l'invio automatico (es. in sviluppo)
# PHOTO_WARMUP=off  per non scaricare all'avvio i link delle foto da iNaturalist
